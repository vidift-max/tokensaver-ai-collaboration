{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "revision",
    "run_id",
    "agent_id",
    "adapter_id",
    "worker_id",
    "attempt",
    "started_at",
    "input_manifest_sha256",
    "effective_permissions"
  ],
  "properties": {
    "mission_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "effective_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "provider_request_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    }
  }
}
