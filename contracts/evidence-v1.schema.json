{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence v1",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository_file",
            "workflow_run",
            "workflow_artifact",
            "log",
            "pull_request",
            "external_reference"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "observed_at",
        "trust"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_file",
            "commit",
            "issue",
            "workflow_run",
            "test_output",
            "log",
            "external_reference",
            "manual_observation"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "trust": {
          "const": "untrusted_data"
        },
        "supports": {
          "type": "string"
        }
      }
    }
  }
}
