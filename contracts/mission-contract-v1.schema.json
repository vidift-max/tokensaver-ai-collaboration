{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokensaver.ai/schemas/mission-contract-v1.schema.json",
  "title": "TokenSaver Collaboration Mission Contract",
  "description": "Versioned interchange contract for missions, agent results, evidence, and normalized errors. This schema does not grant execution or repository permissions.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/mission" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "provider", "role"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "enum": ["openai", "anthropic", "moonshot", "mock", "human", "other"] },
        "model": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["integrator", "editorial", "auditor", "automation", "operator"] }
      }
    },
    "permissionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "operations", "scope"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "operations": { "type": "array", "items": { "type": "string", "enum": ["read", "create_report", "comment_issue", "create_issue", "create_branch", "push_branch", "open_pr", "merge", "release", "manage_secrets", "admin"] }, "uniqueItems": true, "minItems": 1 },
        "scope": { "type": "string", "enum": ["collaboration_repo", "product_repo", "single_issue", "single_branch", "single_path"] },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "approval_ref": { "type": "string", "maxLength": 512 }
      }
    },
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "mission_id", "title", "status", "priority", "created_at", "created_by", "assignee", "objective", "acceptance_criteria", "input_refs", "permissions", "idempotency_key"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "kind": { "const": "mission" },
        "mission_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "status": { "type": "string", "enum": ["BACKLOG", "READY", "RUNNING", "REVIEW_REQUIRED", "APPROVED", "COMPLETED", "BLOCKED", "FAILED", "RETRY_PENDING", "CANCELLED"] },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "created_by": { "$ref": "#/$defs/agent" },
        "assignee": { "$ref": "#/$defs/agent" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "input_refs": { "type": "array", "items": { "type": "string", "format": "uri-reference", "maxLength": 2048 } },
        "target": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "ref": { "type": "string", "maxLength": 256 },
            "paths": { "type": "array", "items": { "type": "string" } }
          }
        },
        "permissions": { "$ref": "#/$defs/permissionRequest" },
        "budget": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "max_cost_usd": { "type": "number", "minimum": 0 },
            "max_input_tokens": { "type": "integer", "minimum": 0 },
            "max_output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
        "correlation_id": { "$ref": "#/$defs/id" },
        "metadata": { "type": "object", "maxProperties": 50, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "type", "uri", "created_at", "producer"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["report", "commit", "pull_request", "workflow_run", "test_result", "log", "artifact", "screenshot", "external_reference"] },
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "producer": { "$ref": "#/$defs/agent" },
        "description": { "type": "string", "maxLength": 2000 },
        "test_status": { "type": "string", "enum": ["passed", "failed", "not_run", "not_applicable"] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "mission_id", "run_id", "agent", "outcome", "started_at", "finished_at", "summary", "evidence", "tests", "limitations"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "kind": { "const": "result" },
        "mission_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "agent": { "$ref": "#/$defs/agent" },
        "outcome": { "type": "string", "enum": ["SUCCEEDED", "PARTIAL", "BLOCKED", "FAILED", "CANCELLED"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "tests": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "status": { "type": "string", "enum": ["passed", "failed", "not_run", "not_applicable"] },
              "command": { "type": "string", "maxLength": 1000 },
              "evidence_ref": { "type": "string", "maxLength": 512 },
              "details": { "type": "string", "maxLength": 4000 }
            }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
        "cost": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "amount_usd": { "type": "number", "minimum": 0 },
            "currency": { "const": "USD" },
            "pricing_version": { "type": "string", "maxLength": 64 }
          }
        },
        "proposed_next_action": { "type": "string", "maxLength": 2000 }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "code", "message", "retryable", "occurred_at"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "kind": { "const": "error" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "mission_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "provider_code": { "type": "string", "maxLength": 128 },
        "safe_details": { "type": "object", "maxProperties": 30, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    }
  }
}