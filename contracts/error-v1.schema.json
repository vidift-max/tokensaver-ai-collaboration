{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "occurred_at"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{2,64}$"
    },
    "category": {
      "enum": [
        "validation",
        "authorization",
        "configuration",
        "rate_limit",
        "provider_unavailable",
        "network",
        "timeout",
        "budget_exceeded",
        "conflict",
        "internal",
        "cancelled",
        "unknown"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "retryable": {
      "type": "boolean"
    },
    "provider_code": {
      "type": "string"
    },
    "provider_request_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "safe_details": {
      "type": "object"
    }
  }
}
