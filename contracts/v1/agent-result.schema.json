{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vidift-max/tokensaver-ai-collaboration/contracts/v1/agent-result.schema.json",
  "title": "Agent Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "revision", "run_id", "agent_id", "attempt", "status", "summary", "artifacts", "evidence", "tests", "limitations", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mission_id": { "type": "string", "minLength": 3, "maxLength": 100 },
    "revision": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 8, "maxLength": 120 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
    "status": { "enum": ["DELIVERED", "BLOCKED", "FAILED", "CANCELLED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "artifacts": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "media_type"], "properties": {
      "path": { "type": "string", "minLength": 1, "maxLength": 500 },
      "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
      "media_type": { "type": "string", "maxLength": 100 },
      "size_bytes": { "type": "integer", "minimum": 0 }
    }}},
    "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json" }, "maxItems": 200 },
    "tests": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 200 },
      "status": { "enum": ["passed", "failed", "not_run", "not_applicable"] },
      "command": { "type": "string", "maxLength": 1000 },
      "environment": { "type": "string", "maxLength": 500 },
      "evidence_id": { "type": "string", "maxLength": 120 }
    }}},
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
    "cost": { "type": "object", "additionalProperties": false, "required": ["currency", "measurement"], "properties": {
      "currency": { "const": "USD" },
      "amount": { "type": ["number", "null"], "minimum": 0 },
      "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
      "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
      "measurement": { "enum": ["provider_reported", "estimated", "unavailable"] }
    }},
    "provider_run_id": { "type": "string", "maxLength": 200 },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}