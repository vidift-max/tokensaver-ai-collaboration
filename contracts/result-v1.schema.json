{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "revision",
    "agent_id",
    "run_id",
    "attempt",
    "status",
    "summary",
    "artifacts",
    "evidence",
    "tests",
    "limitations",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mission_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "DELIVERED",
        "PARTIAL",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "evidence-v1.schema.json#/$defs/artifact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence-v1.schema.json#/$defs/evidence"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "command": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "evidence_locator": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "measurement"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "measurement": {
          "enum": [
            "provider_reported",
            "estimated",
            "unavailable"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "provider_request_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
